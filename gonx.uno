# Log level (DEBUG, INFO, WARN, ERROR)
LogLevel: INFO                          

# Path to TLS-certificates generated by Certbot
TlsKeysDir: /etc/letsencrypt/live       

# TLS listen address
TlsListenAddr: :443                     

# HTTP listen address
HttpListenAddr: :80                     

# Path for ACME challenge files
AcmeChallengePath: /var/lib/letsencrypt 

TLS:
// . www.example.com:  file:///srv/http
// . git.example.com:  tcp://127.0.0.1:8001
// . unix.example.com: unix:///var/lib/app/app.socket
